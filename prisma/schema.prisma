datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// M01 — School & Organization: Konteks organisasi sekolah utama
model Sekolah {
  id              String   @id
  nama            String
  npsn            String?  @unique
  jenjang         String   // SD | SMP | SMA | SMK | UMUM
  alamat          String?
  telepon         String?
  email           String?
  zona_waktu      String   @default("Asia/Jakarta")
  logo_url        String?
  status_aktif    Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  unit_organisasi    UnitOrganisasi[]
  jabatan            Jabatan[]
  penugasan_jabatan  PenugasanJabatan[]
  konfigurasi_sistem KonfigurasiSistem[]
  metadata_berkas    MetadataBerkas[]
  log_audit          LogAudit[]
  pengguna           Pengguna[]
  tahun_ajaran       TahunAjaran[]
  semester           Semester[]
  fase               Fase[]
  tingkat_kelas      TingkatKelas[]
  program_keahlian   ProgramKeahlian[]
  rombel             Rombel[]
  siswa              Siswa[]
  keikutsertaan_siswa KeikutsertaanSiswa[]
  penempatan_rombel  PenempatanRombel[]

  @@map("sekolah")
}

/// M01 — School & Organization: Bagian atau unit organisasi sekolah
model UnitOrganisasi {
  id              String   @id
  sekolah_id      String
  nama            String
  kode            String?
  induk_unit_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  sekolah         Sekolah           @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  induk_unit      UnitOrganisasi?   @relation("HierarkiUnit", fields: [induk_unit_id], references: [id], onDelete: SetNull)
  sub_unit        UnitOrganisasi[]  @relation("HierarkiUnit")
  jabatan         Jabatan[]

  @@unique([sekolah_id, nama])
  @@map("unit_organisasi")
}

/// M01 — School & Organization: Jabatan organisasi struktural (Kepala Sekolah, Wakasek, dll)
model Jabatan {
  id              String   @id
  sekolah_id      String
  unit_id         String?
  kode_jabatan    String   // HEADMASTER | VICE_PRINCIPAL_CURRICULUM | VICE_PRINCIPAL_STUDENT_AFFAIRS | PROGRAM_HEAD | CUSTOM
  nama_jabatan    String
  tingkat_akses   String?  // Scope default (SCHOOL_WIDE | UNIT_WIDE | PROGRAM_WIDE)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  sekolah         Sekolah           @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  unit            UnitOrganisasi?   @relation(fields: [unit_id], references: [id], onDelete: SetNull)
  penugasan       PenugasanJabatan[]

  @@unique([sekolah_id, kode_jabatan])
  @@map("jabatan")
}

/// M01 — School & Organization: Penugasan personil ke jabatan dalam periode tertentu
model PenugasanJabatan {
  id              String    @id
  sekolah_id      String
  jabatan_id      String
  personil_id     String    // Mengacu ke User Account / Profil Personil
  berlaku_mulai   DateTime
  berlaku_sampai  DateTime?
  status          String    @default("AKTIF") // AKTIF | SELESAI | DIBATALKAN
  catatan         String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  sekolah         Sekolah   @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  jabatan         Jabatan   @relation(fields: [jabatan_id], references: [id], onDelete: Restrict)

  @@index([personil_id, status])
  @@map("penugasan_jabatan")
}

/// M03 — Platform Configuration: Parameter konfigurasi sistem & sekolah
model KonfigurasiSistem {
  id              String   @id
  sekolah_id      String?
  kunci           String
  nilai           String
  kategori        String   @default("UMUM") // UMUM | AKADEMIK | TAMPILAN | INTEGRASI
  deskripsi       String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  sekolah         Sekolah? @relation(fields: [sekolah_id], references: [id], onDelete: SetNull)

  @@unique([sekolah_id, kunci])
  @@map("konfigurasi_sistem")
}

/// M04 — File & Document: Metadata berkas privat & attachment
model MetadataBerkas {
  id                String   @id
  sekolah_id        String?
  nama_file_asli    String
  storage_provider  String   @default("LOCAL") // LOCAL | S3_COMPATIBLE
  storage_key       String   @unique
  mime_type         String
  ukuran_byte       Int
  checksum          String?
  status            String   @default("AKTIF") // DRAFT | AKTIF | TERHAPUS
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  sekolah           Sekolah? @relation(fields: [sekolah_id], references: [id], onDelete: SetNull)

  @@index([storage_provider, status])
  @@map("metadata_berkas")
}

/// M05 — Audit & Traceability: Log audit transaksi & mutasi data (Append-only)
model LogAudit {
  id                String   @id
  sekolah_id        String?
  aktor_id          String
  aktor_role        String
  aksi              String   // CREATE | UPDATE | DELETE | PUBLISH | FINALIZE | AUTH_LOGIN | dll
  tipe_sumber       String   // Nama agregat / modul terkait (e.g. SEKOLAH | PENILAIAN | PRESENSI | PENGGUNA)
  id_sumber         String
  payload_sebelum   String?  // JSON snapshot sebelum perubahan (opsional)
  payload_sesudah   String?  // JSON snapshot setelah perubahan (opsional)
  ip_address        String?
  user_agent        String?
  dibuat_pada       DateTime @default(now())

  sekolah           Sekolah? @relation(fields: [sekolah_id], references: [id], onDelete: SetNull)

  @@index([sekolah_id, dibuat_pada])
  @@index([aktor_id, dibuat_pada])
  @@index([tipe_sumber, id_sumber])
  @@map("log_audit")
}

/// Data Architecture: Transactional Outbox untuk pemrosesan asinkron reliabel
model OutboxPesan {
  id                         String    @id
  tipe_event                 String
  tipe_agregat               String
  id_agregat                 String
  payload                    String    // JSON data spesifik downstream
  status                     String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  jumlah_percobaan           Int       @default(0)
  maks_percobaan             Int       @default(5)
  percobaan_berikutnya_pada  DateTime  @default(now())
  diproses_pada              DateTime?
  pesan_error                String?
  dibuat_pada                DateTime  @default(now())
  diperbarui_pada            DateTime  @updatedAt

  @@index([status, percobaan_berikutnya_pada])
  @@map("outbox_pesan")
}

/// M02 — Identity & Access: Akun pengguna autentikasi
model Pengguna {
  id                     String    @id
  sekolah_id             String?
  username               String    @unique
  email                  String?   @unique
  password_hash          String
  nama_lengkap           String
  peran_dasar            String    // SUPER_ADMIN | SCHOOL_STAFF | TEACHER | STUDENT | GUARDIAN
  status_akun            String    @default("AKTIF") // AKTIF | NONAKTIF | TERKUNCI | DITANGGUHKAN | MENUNGGU_VERIFIKASI
  harus_ganti_password   Boolean   @default(false)
  terakhir_login_pada    DateTime?
  percobaan_login_gagal  Int       @default(0)
  dikunci_sampai         DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  sekolah                Sekolah?              @relation(fields: [sekolah_id], references: [id], onDelete: SetNull)
  sesi                   SesiPengguna[]
  kemampuan_staff        KemampuanStaff[]
  siswa                  Siswa?

  @@index([sekolah_id, peran_dasar])
  @@index([status_akun])
  @@map("pengguna")
}

/// M02 — Identity & Access: Penugasan capability bundle untuk SCHOOL_STAFF
model KemampuanStaff {
  id              String    @id
  pengguna_id     String
  kode_kemampuan  String    // SYSTEM_ADMIN | ACADEMIC_OPERATOR | STUDENT_DATA_OPERATOR | REPORT_OPERATOR
  created_at      DateTime  @default(now())

  pengguna        Pengguna  @relation(fields: [pengguna_id], references: [id], onDelete: Cascade)

  @@unique([pengguna_id, kode_kemampuan])
  @@index([kode_kemampuan])
  @@map("kemampuan_staff")
}

/// M02 — Identity & Access: Sesi aktif server-authoritative
model SesiPengguna {
  id                  String    @id
  pengguna_id         String
  token_hash          String    @unique
  ip_address          String?
  user_agent          String?
  berlaku_sampai      DateTime
  terakhir_aktif_pada DateTime  @default(now())
  dicabut             Boolean   @default(false)
  alasan_cabut        String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  pengguna            Pengguna  @relation(fields: [pengguna_id], references: [id], onDelete: Cascade)

  @@index([pengguna_id, dicabut, berlaku_sampai])
  @@map("sesi_pengguna")
}

/// M02 — Identity & Access: Pencatatan percobaan login untuk mitigasi brute force
model LogPercobaanLogin {
  id              String    @id
  identifier      String    // username atau IP address
  ip_address      String
  sukses          Boolean
  alasan_gagal    String?
  dibuat_pada     DateTime  @default(now())

  @@index([identifier, dibuat_pada])
  @@index([ip_address, dibuat_pada])
  @@map("log_percobaan_login")
}

/// M06 — Academic Period & Structure: Tahun Ajaran (Konteks siklus akademik tahunan)
model TahunAjaran {
  id              String               @id
  sekolah_id      String
  nama            String               // e.g. "2026/2027"
  kode            String?              // e.g. "TA-2026-2027"
  tanggal_mulai   DateTime
  tanggal_selesai DateTime
  status          String               @default("DRAFT") // DRAFT | AKTIF | SELESAI | DIARSIPKAN
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  sekolah             Sekolah              @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  semester            Semester[]
  rombel              Rombel[]
  keikutsertaan_siswa KeikutsertaanSiswa[]

  @@unique([sekolah_id, nama])
  @@index([sekolah_id, status])
  @@map("tahun_ajaran")
}

/// M06 — Academic Period & Structure: Semester dalam Tahun Ajaran
model Semester {
  id              String      @id
  sekolah_id      String
  tahun_ajaran_id String
  nama            String      // e.g. "Semester Ganjil", "Semester Genap"
  kode            String      // GANJIL | GENAP | PENDEK
  urutan          Int         @default(1) // 1 = Ganjil, 2 = Genap, 3 = Pendek
  tanggal_mulai   DateTime
  tanggal_selesai DateTime
  status          String      @default("DRAFT") // DRAFT | AKTIF | SELESAI | DIARSIPKAN
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  sekolah         Sekolah     @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  tahun_ajaran    TahunAjaran @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Restrict)
  rombel          Rombel[]

  @@unique([tahun_ajaran_id, kode])
  @@index([sekolah_id, status])
  @@map("semester")
}

/// M06 — Academic Period & Structure: Fase Pendidikan (Kurikulum Merdeka / Jenjang Pendidikan)
model Fase {
  id              String         @id
  sekolah_id      String
  nama            String         // e.g. "Fase E", "Fase F", "Fase A"
  kode            String         // e.g. "FASE_E", "FASE_F"
  deskripsi       String?
  urutan          Int            @default(1)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  sekolah         Sekolah        @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  tingkat_kelas   TingkatKelas[]
  rombel          Rombel[]

  @@unique([sekolah_id, kode])
  @@map("fase")
}

/// M06 — Academic Period & Structure: Tingkat / Grade Level (X, XI, XII / 1-12)
model TingkatKelas {
  id              String               @id
  sekolah_id      String
  fase_id         String?
  kode            String               // e.g. "10", "11", "12" atau "X", "XI", "XII"
  nama            String               // e.g. "Kelas 10", "Kelas X"
  urutan          Int                  @default(1)
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  sekolah             Sekolah              @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  fase                Fase?                @relation(fields: [fase_id], references: [id], onDelete: SetNull)
  rombel              Rombel[]
  keikutsertaan_siswa KeikutsertaanSiswa[]

  @@unique([sekolah_id, kode])
  @@map("tingkat_kelas")
}

/// M06 — Academic Period & Structure: Program Akademik / Jurusan / Konsentrasi Keahlian
model ProgramKeahlian {
  id              String     @id
  sekolah_id      String
  kode            String     // e.g. "RPL", "TKJ", "DKV", "IPA", "IPS", "UMUM"
  nama            String     // e.g. "Rekayasa Perangkat Lunak"
  jenjang         String?    // e.g. "SMK", "SMA", "SMP", "SD"
  status_aktif    Boolean    @default(true)
  deskripsi       String?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  sekolah         Sekolah    @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  rombel          Rombel[]

  @@unique([sekolah_id, kode])
  @@map("program_keahlian")
}

/// M06 — Academic Period & Structure: Rombel / Rombongan Belajar (Kelompok Belajar Periodik)
model Rombel {
  id                String             @id
  sekolah_id        String
  tahun_ajaran_id   String
  semester_id       String?
  tingkat_id        String
  fase_id           String?
  program_id        String?            // Opsional (null untuk non-kejuruan / SD / SMP / SMA Umum)
  nama              String             // e.g. "X RPL 1", "XI TO 2", "7A"
  kode              String?            // e.g. "RBL-X-RPL-1"
  kapasitas         Int                @default(36)
  status            String             @default("AKTIF") // AKTIF | NONAKTIF | DIARSIPKAN
  catatan           String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  sekolah           Sekolah            @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  tahun_ajaran      TahunAjaran        @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Restrict)
  semester          Semester?          @relation(fields: [semester_id], references: [id], onDelete: SetNull)
  tingkat           TingkatKelas       @relation(fields: [tingkat_id], references: [id], onDelete: Restrict)
  fase              Fase?              @relation(fields: [fase_id], references: [id], onDelete: SetNull)
  program           ProgramKeahlian?   @relation(fields: [program_id], references: [id], onDelete: SetNull)
  penempatan_rombel PenempatanRombel[]

  @@unique([sekolah_id, tahun_ajaran_id, nama])
  @@index([sekolah_id, tahun_ajaran_id, status])
  @@map("rombel")
}

/// M07 — Student Academic Lifecycle: Identitas Dasar Siswa (Individu)
model Siswa {
  id               String    @id
  sekolah_id       String
  pengguna_id      String?   @unique
  nis              String    // Nomor Induk Siswa lokal sekolah
  nisn             String?   // Nomor Induk Siswa Nasional (10 digit)
  nama_lengkap     String
  jenis_kelamin    String    // L | P
  tempat_lahir     String?
  tanggal_lahir    DateTime?
  agama            String?   // ISLAM | KRISTEN | KATOLIK | HINDU | BUDDHA | KONGHUCU | LAINNYA
  nik              String?
  alamat           String?
  nama_wali        String?
  telepon_wali     String?
  email_wali       String?
  status_akademik  String    @default("AKTIF") // AKTIF | NONAKTIF | LULUS | PINDAH | KELUAR | DROPOUT
  foto_url         String?   // URL atau data foto profil siswa
  tanggal_masuk    DateTime  @default(now())
  tanggal_keluar   DateTime?
  catatan          String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  sekolah          Sekolah              @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  pengguna         Pengguna?            @relation(fields: [pengguna_id], references: [id], onDelete: SetNull)
  keikutsertaan    KeikutsertaanSiswa[]

  @@unique([sekolah_id, nis])
  @@index([sekolah_id, status_akademik])
  @@index([sekolah_id, nisn])
  @@map("siswa")
}

/// M07 — Student Academic Lifecycle: Keikutsertaan Siswa per Periode Akademik (Enrollment)
model KeikutsertaanSiswa {
  id              String             @id
  sekolah_id      String
  siswa_id        String
  tahun_ajaran_id String
  tingkat_id      String?
  status          String             @default("AKTIF") // AKTIF | LULUS | NAIK_KELAS | TINGGAL_KELAS | PINDAH | NONAKTIF
  tanggal_mulai   DateTime           @default(now())
  tanggal_selesai DateTime?
  catatan         String?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  sekolah         Sekolah            @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  siswa           Siswa              @relation(fields: [siswa_id], references: [id], onDelete: Restrict)
  tahun_ajaran    TahunAjaran        @relation(fields: [tahun_ajaran_id], references: [id], onDelete: Restrict)
  tingkat         TingkatKelas?      @relation(fields: [tingkat_id], references: [id], onDelete: SetNull)
  penempatan      PenempatanRombel[]

  @@unique([siswa_id, tahun_ajaran_id])
  @@index([sekolah_id, tahun_ajaran_id, status])
  @@map("keikutsertaan_siswa")
}

/// M07 — Student Academic Lifecycle: Penempatan Siswa ke Rombongan Belajar (Rombel Placement)
model PenempatanRombel {
  id               String             @id
  sekolah_id       String
  keikutsertaan_id String
  rombel_id        String
  tanggal_mulai    DateTime           @default(now())
  tanggal_selesai  DateTime?
  status           String             @default("AKTIF") // AKTIF | PINDAH | SELESAI | DIBATALKAN
  nomor_absen      Int?
  catatan          String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  sekolah          Sekolah            @relation(fields: [sekolah_id], references: [id], onDelete: Restrict)
  keikutsertaan    KeikutsertaanSiswa @relation(fields: [keikutsertaan_id], references: [id], onDelete: Restrict)
  rombel           Rombel             @relation(fields: [rombel_id], references: [id], onDelete: Restrict)

  @@index([rombel_id, status])
  @@index([keikutsertaan_id, status])
  @@index([sekolah_id, status])
  @@map("penempatan_rombel")
}
